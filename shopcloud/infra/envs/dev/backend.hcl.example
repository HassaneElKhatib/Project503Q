# GitHub Actions uses committed backend.tf (same values). Use backend.hcl locally only if you override.
#
# Copy to backend.hcl after running infra/bootstrap once:
#   cd infra/bootstrap && terraform init && terraform apply
#   cd ../envs/dev && cp backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl

bucket         = "shopcloud-tfstate-712044128773"
key            = "infra/envs/dev/terraform.tfstate"
region         = "eu-central-1"
encrypt        = true
dynamodb_table = "shopcloud-tf-locks"
