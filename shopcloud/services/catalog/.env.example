# Copy to .env for local dev. Never commit .env.
SERVICE_NAME=catalog
SERVICE_VERSION=local
ENVIRONMENT=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Day 1: JSON file. Day 2: replace with DATABASE_URL pointing at C's RDS.
PRODUCTS_JSON_PATH=./data/products.json

# Optional - if unset, caching is disabled and the service falls back to repo
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
