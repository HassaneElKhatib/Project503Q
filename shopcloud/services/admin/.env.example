SERVICE_NAME=admin
SERVICE_VERSION=local
ENVIRONMENT=local
LOG_LEVEL=INFO

# Same Postgres as checkout/catalog
DATABASE_URL=postgresql+asyncpg://shopcloud:CHANGEME@localhost:5432/shopcloud
DB_POOL_SIZE=5

# IMPORTANT: ADMIN Cognito pool, NOT the customer pool
COGNITO_USER_POOL_ID=us-east-1_REPLACE_ME_ADMIN_POOL
COGNITO_APP_CLIENT_ID=replace_me
COGNITO_REGION=us-east-1

REQUIRED_ADMIN_GROUP=admin

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
