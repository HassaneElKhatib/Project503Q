SERVICE_NAME=api-gateway
LOG_LEVEL=info

# CORS origins for the customer-web SPA (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Local SQLite path for users / orders / reviews. In production the
# gateway should be replaced or routed at Cognito + RDS.
GATEWAY_DB_URL=sqlite+aiosqlite:///./gateway.db

# JWT signing secret for local-mode auth. Set in production via Secrets
# Manager when running under EKS.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# Optional upstream ShopCloud service URLs. When set, the gateway will
# proxy product reads to the catalog service and cart writes to the
# cart service. Leave empty to use the gateway's local store.
CATALOG_BASE_URL=
CART_BASE_URL=
CHECKOUT_BASE_URL=
ADMIN_BASE_URL=
AUTH_BASE_URL=

# SMTP — login OTP, password reset, invoices. On EKS, prefer Secrets Manager
# /shopcloud/<env>/api-gateway/smtp (see infra secrets module) synced by External Secrets.
# For AWS SES: create SMTP credentials in SES console; host email-smtp.<region>.amazonaws.com:587 TLS.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=ShopCloud
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Seed admin used to bootstrap the local stack. Change before sharing.
SEED_ADMIN_EMAIL=admin@shopcloud.io
SEED_ADMIN_PASSWORD=AdminPass1!
SEED_ADMIN_NAME=ShopCloud Admin
