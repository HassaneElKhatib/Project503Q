SERVICE_NAME=checkout
SERVICE_VERSION=local
ENVIRONMENT=local
LOG_LEVEL=INFO

# RDS Postgres - WRITE endpoint (never the read replica - checkout needs to insert orders)
DATABASE_URL=postgresql+asyncpg://shopcloud:CHANGEME@localhost:5432/shopcloud
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ElastiCache Redis (same instance cart service uses)
REDIS_URL=redis://localhost:6379/1

# SQS invoice queue URL (set by Terraform output)
INVOICE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/REPLACE_ME/shopcloud-invoice-dev
SQS_MAX_ATTEMPTS=3
AWS_REGION=us-east-1

COGNITO_USER_POOL_ID=us-east-1_REPLACE_ME
COGNITO_APP_CLIENT_ID=replace_me
COGNITO_REGION=us-east-1
