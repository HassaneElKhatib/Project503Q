SERVICE_NAME=auth
SERVICE_VERSION=local
ENVIRONMENT=local
LOG_LEVEL=INFO

# Cognito - filled in by Terraform via Secrets Manager in prod/dev.
# For local dev, paste from your Cognito user pool.
COGNITO_USER_POOL_ID=us-east-1_REPLACE_ME
COGNITO_APP_CLIENT_ID=replace_me
# COGNITO_APP_CLIENT_SECRET=optional_only_if_client_has_secret
COGNITO_REGION=us-east-1
COGNITO_DOMAIN=shopcloud-auth-dev.auth.us-east-1.amazoncognito.com

# Public URLs - must match the app client's allowed callback/logout URLs
CALLBACK_URL=https://dev.shopcloud.example/auth/callback
LOGOUT_REDIRECT_URL=https://dev.shopcloud.example/
POST_LOGIN_REDIRECT=/

# Cookies
COOKIE_DOMAIN=.shopcloud.example
COOKIE_SECURE=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
STATE_SIGNING_KEY=REPLACE_WITH_A_RANDOM_STRING_AT_LEAST_32_CHARS_LONG
STATE_TTL_SECONDS=300
