# Copy to .env (gitignored).
# The api-gateway is the BFF for the React UI. In docker-compose it
# is published on http://localhost:8080.

VITE_BACKEND_URL=http://localhost:8080

# Optional: Google OAuth and Supabase (only used by Google sign-in
# and admin product image upload). Leave blank to disable those flows.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
